# ============================================================
# 毕数飞行平台 - 根目录 .gitignore
# ============================================================

# --- 依赖目录 ---
node_modules/

# --- 构建产物 ---
dist/
unpackage/
*.local

# --- AI 工具本地工作记忆 ---
.workbuddy/memory/

# --- 临时文件 ---
*.tmp
*.temp
~$*
_v3_tmp*

# --- 系统文件 ---
.DS_Store
Thumbs.db
desktop.ini

# --- 编辑器/IDE ---
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- 日志文件 ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 环境变量（含敏感信息） ---
.env.local
.env.*.local

# --- 文档站缓存 ---
.vitepress/cache/
.vitepress/dist/

# --- 微信开发者工具 ---
project.private.config.json
